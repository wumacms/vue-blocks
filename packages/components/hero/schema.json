[
  {
    "name": "title",
    "type": "textarea",
    "label": "模块标题",
    "default": "企业级即时通讯<br>让协作更快一步",
    "help": "支持 <br> 换行和 <strong> 加粗"
  },
  {
    "name": "description",
    "type": "textarea",
    "label": "模块描述",
    "default": "安全、高效、可定制——专为现代企业打造的智能聊天平台，集成工作流与数据洞察。"
  },
  {
    "name": "buttons",
    "type": "repeater",
    "label": "按钮列表",
    "fields": [
      {
        "name": "btnText",
        "type": "text",
        "label": "按钮文字"
      },
      {
        "name": "btnLink",
        "type": "text",
        "label": "链接地址",
        "placeholder": "/或https://"
      },
      {
        "name": "isPrimary",
        "type": "boolean",
        "label": "突出显示"
      },
      {
        "name": "newWindow",
        "type": "boolean",
        "label": "新窗口打开"
      }
    ],
    "default": [
      {
        "btnLink": "#",
        "btnText": "开始免费使用",
        "isPrimary": true,
        "newWindow": false
      },
      {
        "btnLink": "#",
        "btnText": "联系销售",
        "isPrimary": false,
        "newWindow": false
      }
    ]
  },
  {
    "name": "image",
    "type": "image",
    "label": "封面图片",
    "default": "https://images.unsplash.com/photo-1557804506-669a67965ba0?ixlib=rb-4.0.3&auto=format&fit=crop&w=900&q=60",
    "help": "建议尺寸 1200x675px (16:9)"
  },
  {
    "name": "imageAlt",
    "type": "text",
    "label": "图片描述",
    "default": "团队协作界面",
    "help": "用于无障碍访问和搜索引擎优化"
  },
  {
    "name": "bgImage",
    "type": "image",
    "label": "背景图片",
    "default": "https://images.unsplash.com/photo-1497215728101-856f4ea42174?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80",
    "help": "建议 1920x1080px (16:9)"
  },
  {
    "name": "bgImageAlt",
    "type": "text",
    "label": "背景图片描述",
    "default": "团队协作背景"
  },
  {
    "name": "overlayOpacity",
    "type": "select",
    "label": "遮罩透明度",
    "options": [
      {
        "label": "10%",
        "value": "10"
      },
      {
        "label": "20%",
        "value": "20"
      },
      {
        "label": "30%",
        "value": "30"
      },
      {
        "label": "40%",
        "value": "40"
      },
      {
        "label": "50% (推荐)",
        "value": "50"
      },
      {
        "label": "60%",
        "value": "60"
      },
      {
        "label": "70%",
        "value": "70"
      },
      {
        "label": "80%",
        "value": "80"
      },
      {
        "label": "90%",
        "value": "90"
      }
    ],
    "default": "50"
  },
  {
    "name": "textWhite",
    "type": "boolean",
    "label": "文字使用白色",
    "default": true,
    "help": "勾选后标题和描述为白色，取消则为深灰色"
  },
  {
    "name": "textColor",
    "type": "select",
    "label": "文字颜色",
    "options": [
      {
        "label": "白色 (推荐)",
        "value": "text-white"
      },
      {
        "label": "深灰色",
        "value": "text-gray-900"
      }
    ],
    "default": "text-white"
  },
  {
    "name": "descriptionColor",
    "type": "select",
    "label": "描述文字颜色",
    "options": [
      {
        "label": "白色/半透明 (推荐)",
        "value": "text-white/80"
      },
      {
        "label": "纯白色",
        "value": "text-white"
      },
      {
        "label": "深灰色",
        "value": "text-gray-700"
      }
    ],
    "default": "text-white/80"
  }
]