[
  {
    "name": "title",
    "type": "text",
    "label": "区块标题",
    "default": "我们的产品",
    "help": "主标题，通常为2-4个字"
  },
  {
    "name": "description",
    "type": "text",
    "label": "区块副标题",
    "default": "为企业打造的智能协作工具矩阵",
    "help": "简短描述，概括区块内容"
  },
  {
    "name": "products",
    "type": "repeater",
    "label": "产品列表",
    "fields": [
      {
        "name": "image",
        "type": "image",
        "label": "产品图片",
        "default": "https://images.unsplash.com/photo-1611162616475-46b635cb6868?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&h=400&q=60",
        "help": "建议尺寸 600x400px (3:2)，使用高质量产品截图或场景图"
      },
      {
        "name": "imageAlt",
        "type": "text",
        "label": "图片描述",
        "default": "产品界面截图",
        "help": "用于无障碍访问和搜索引擎优化"
      },
      {
        "name": "title",
        "type": "text",
        "label": "产品名称",
        "default": "即时通讯",
        "help": "产品标题，建议2-4个字"
      },
      {
        "name": "description",
        "type": "textarea",
        "label": "产品描述",
        "default": "企业级实时消息系统，支持群聊、私聊、富媒体分享，消息历史永久保存。",
        "help": "建议30-50字，概括产品核心功能"
      },
      {
        "name": "tags",
        "type": "repeater",
        "label": "特性标签",
        "fields": [
          {
            "name": "text",
            "type": "text",
            "label": "标签文字"
          }
        ],
        "default": [
          {
            "text": "端到端加密"
          },
          {
            "text": "已读回执"
          },
          {
            "text": "多端同步"
          }
        ],
        "help": "显示在产品卡片底部的特性标签，建议2-4个"
      },
      {
        "name": "link",
        "type": "text",
        "label": "详情链接",
        "default": "#",
        "help": "点击「了解详情」跳转的目标地址"
      },
      {
        "name": "newWindow",
        "type": "boolean",
        "label": "新窗口打开",
        "default": false,
        "help": "勾选后点击链接将在新标签页打开"
      },
      {
        "name": "badge",
        "type": "text",
        "label": "角标文字（可选）",
        "default": "",
        "help": "显示在卡片右上角的标签，如「热门」「新品」「推荐」，留空则不显示"
      },
      {
        "name": "badgeColor",
        "type": "select",
        "label": "角标颜色",
        "options": [
          {
            "label": "靛蓝",
            "value": "bg-indigo-600"
          },
          {
            "label": "翠绿",
